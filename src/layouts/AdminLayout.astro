---
// Layout del área privada. Solo se usa en páginas bajo `/admin`, donde el middleware ya garantiza
// que `Astro.locals.user` existe y es personal.
const { titulo = "Panel" } = Astro.props;
const usuario = Astro.locals.user;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{titulo} · TravelTech</title>
  </head>
  <body>
    <header>
      <a href="/admin">
        <strong>TravelTech</strong>
      </a>
      <nav aria-label="Principal">
        <a href="/admin">Inicio</a>
      </nav>
      <span>
        {usuario?.name} ({usuario?.role})
      </span>
      <button type="button" id="cerrar-sesion">
        Cerrar sesión
      </button>
    </header>
    <main>
      <slot />
    </main>
    <script>
      document.querySelector("#cerrar-sesion")?.addEventListener("click", async () => {
        await fetch("/api/auth/sign-out", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: "{}",
        });
        location.assign("/login");
      });
    </script>
    <style>
      body {
        font-family: system-ui, sans-serif;
        margin: 0;
      }
      header {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 0.75rem 1rem;
        border-bottom: 1px solid #ccc;
      }
      header nav {
        flex: 1;
      }
      main {
        padding: 1rem;
      }
    </style>
  </body>
</html>
