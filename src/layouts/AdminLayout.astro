---
import "../styles/global.css";
import { esAdmin } from "@lib/guards";
// Layout del área privada. Solo se usa en páginas bajo `/admin`, donde el middleware ya garantiza
// que `Astro.locals.user` existe y es personal.
const { titulo = "Panel" } = Astro.props;
const usuario = Astro.locals.user;
// Ocultar el enlace no protege nada: el middleware devuelve 403 al operador en `/admin/catalogo` y `/admin/cuentas`.
const verAdmin = esAdmin(usuario);
const enlace =
  "rounded-sm underline-offset-4 outline-none hover:underline focus-visible:ring-3 focus-visible:ring-ring/50";
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{titulo} · TravelTech</title>
  </head>
  <body>
    <header class="flex flex-wrap items-center gap-4 border-b px-4 py-3">
      <a href="/admin" class={enlace}>
        <strong>TravelTech</strong>
      </a>
      <nav aria-label="Principal" class="flex flex-1 gap-4">
        <a href="/admin" class={enlace}>
          Inicio
        </a>
        {verAdmin && (
          <>
            <a href="/admin/catalogo" class={enlace}>
              Catálogo
            </a>
            <a href="/admin/cuentas" class={enlace}>
              Cuentas
            </a>
          </>
        )}
      </nav>
      <span class="text-sm text-muted-foreground">
        {usuario?.name} ({usuario?.role})
      </span>
      <button
        type="button"
        id="cerrar-sesion"
        class="h-8 rounded-lg border px-2.5 text-sm outline-none hover:bg-muted focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/50"
      >
        Cerrar sesión
      </button>
    </header>
    <main class="p-4">
      <slot />
    </main>
    <script>
      document.querySelector("#cerrar-sesion")?.addEventListener("click", async () => {
        await fetch("/api/auth/sign-out", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: "{}",
        });
        location.assign("/login");
      });
    </script>
  </body>
</html>
