---
import "../styles/global.css";
// Layout del catálogo público (visitantes sin sesión). Cada página aporta su único `h1`.
const { titulo = "Catálogo" } = Astro.props;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo} · TravelTech</title>
  </head>
  <body>
    <header class="border-b px-4 py-3">
      <a href="/" class="rounded-sm outline-none focus-visible:ring-3 focus-visible:ring-ring/50">
        <strong>TravelTech</strong>
      </a>
    </header>
    <main class="mx-auto max-w-5xl p-4">
      <slot />
    </main>
  </body>
</html>
