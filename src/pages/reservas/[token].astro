---
import PublicLayout from "@layouts/PublicLayout.astro";
import { baseDelServidor } from "@db/servidor";
import { formatearFecha } from "@lib/fechas";
import { formatearPesos } from "@lib/importes";
import { noEncontrado } from "@lib/no-encontrado";
import PedirInstrucciones from "@components/pagos/PedirInstrucciones";
import ReportarPago from "@components/pagos/ReportarPago";
import { crearReservas } from "@modules/bookings/container";
import { crearPagos } from "@modules/payments/container";

// Solo lectura: un GET nunca modifica datos. El middleware añade `Cache-Control: no-store` y
// `Referrer-Policy: no-referrer` a toda `/reservas/*`. Token inexistente, inválido o malformado
// responden el mismo `404`: no se revela si la reserva existe. No se registra el token ni la URL.
const base = await baseDelServidor();
const token = Astro.params.token ?? "";
const reserva = await crearReservas(base).bookings.findByToken(token);
if (!reserva) return noEncontrado();
// Lectura pura: muestra las instrucciones ya emitidas; pedirlas (escritura) es una Action.
const pagos = crearPagos(base);
const pago = await pagos.allocations.find(token);
const reportes = await pagos.reports.list(token);
// Mismas condiciones que la Action: instrucciones vigentes y saldo por pagar (el servidor revalida).
const puedeReportar = pago !== null && pago.pendingCents > 0;
const ESTADOS_REPORTE = {
  pendiente: "En revisión",
  verificado: "Verificado",
  rechazado: "Rechazado",
  reemplazado: "Reemplazado",
} as const;
const puedePedir = !pago && (reserva.status === "pendiente" || reserva.status === "parcial");

const zona = process.env.AGENCY_TIMEZONE!;
const ESTADOS = {
  pendiente: "Pendiente",
  en_revision: "En revisión",
  parcial: "Pago parcial",
  pagada: "Pagada",
  expirada: "Expirada",
  cancelada: "Cancelada",
} as const;
const CATEGORIAS = { adulto: "Adulto", menor: "Menor", infante: "Infante" } as const;
---

<PublicLayout titulo={`Reserva ${reserva.reference}`}>
  <h1 class="mb-4 text-3xl font-semibold">Reserva {reserva.reference}</h1>
  <dl class="mb-6 grid gap-1">
    <div>
      <dt class="mr-1 inline font-medium">Estado:</dt>
      <dd class="inline">{ESTADOS[reserva.status]}</dd>
    </div>
    {reserva.status === "pendiente" && (
      <div>
        <dt class="mr-1 inline font-medium">Vigente hasta:</dt>
        <dd class="inline">{formatearFecha(reserva.expiresAt, zona)}</dd>
      </div>
    )}
    {reserva.status === "expirada" && (
      <div>
        <dt class="mr-1 inline font-medium">Venció:</dt>
        <dd class="inline">{formatearFecha(reserva.expiresAt, zona)}</dd>
      </div>
    )}
    <div>
      <dt class="mr-1 inline font-medium">Paquete:</dt>
      <dd class="inline">{reserva.packageName}</dd>
    </div>
    <div>
      <dt class="mr-1 inline font-medium">Salida:</dt>
      <dd class="inline">{formatearFecha(reserva.startsAt, zona)}</dd>
    </div>
    <div>
      <dt class="mr-1 inline font-medium">Regreso:</dt>
      <dd class="inline">{formatearFecha(reserva.endsAt, zona)}</dd>
    </div>
    <div>
      <dt class="mr-1 inline font-medium">Punto de abordaje:</dt>
      <dd class="inline">{reserva.boardingPointName}</dd>
    </div>
    <div>
      <dt class="mr-1 inline font-medium">Contacto:</dt>
      <dd class="inline">{reserva.buyerName}</dd>
    </div>
  </dl>
  <h2 class="mb-2 text-2xl font-semibold">Pasajeros</h2>
  <table class="mb-4 w-full max-w-xl text-sm">
    <thead>
      <tr>
        <th scope="col" class="border-b px-3 py-2 text-left font-medium">
          Nombre
        </th>
        <th scope="col" class="border-b px-3 py-2 text-left font-medium">
          Categoría
        </th>
        <th scope="col" class="border-b px-3 py-2 text-left font-medium">
          Precio
        </th>
      </tr>
    </thead>
    <tbody>
      {reserva.passengers.map((p) => (
        <tr>
          <td class="border-b px-3 py-2">{p.fullName}</td>
          <td class="border-b px-3 py-2">{CATEGORIAS[p.fareCategory]}</td>
          <td class="border-b px-3 py-2">{formatearPesos(p.priceSnapshotCents)}</td>
        </tr>
      ))}
    </tbody>
  </table>
  <p class="mb-6 text-lg">
    <strong>Total: {formatearPesos(reserva.totalCents)}</strong>
  </p>
  {pago && (
    <section aria-labelledby="pago-titulo">
      <h2 id="pago-titulo" class="mb-2 text-2xl font-semibold">
        Instrucciones de pago SPEI
      </h2>
      <dl class="mb-2 grid gap-1">
        <div>
          <dt class="mr-1 inline font-medium">Banco:</dt>
          <dd class="inline">{pago.instructions.bankName}</dd>
        </div>
        <div>
          <dt class="mr-1 inline font-medium">Titular:</dt>
          <dd class="inline">{pago.instructions.accountHolder}</dd>
        </div>
        <div>
          <dt class="mr-1 inline font-medium">CLABE:</dt>
          <dd class="inline">{pago.instructions.clabe}</dd>
        </div>
        <div>
          <dt class="mr-1 inline font-medium">Concepto:</dt>
          <dd class="inline">{pago.instructions.reference}</dd>
        </div>
        <div>
          <dt class="mr-1 inline font-medium">Saldo por pagar:</dt>
          <dd class="inline">{formatearPesos(pago.pendingCents)}</dd>
        </div>
      </dl>
    </section>
  )}
  {puedeReportar && (
    <section aria-labelledby="reportar-titulo" class="mt-6">
      <h2 id="reportar-titulo" class="mb-2 text-2xl font-semibold">
        Reportar un pago
      </h2>
      <p class="mb-4 text-sm">
        Enviar un comprobante no confirma el pago: la agencia lo revisa y, solo cuando lo verifica,
        se descuenta de tu saldo.
      </p>
      <ReportarPago client:load token={token} />
    </section>
  )}
  {reportes.length > 0 && (
    <section aria-labelledby="reportes-titulo" class="mt-6">
      <h2 id="reportes-titulo" class="mb-2 text-2xl font-semibold">
        Tus reportes de pago
      </h2>
      <table class="w-full max-w-xl text-sm">
        <thead>
          <tr>
            <th scope="col" class="border-b px-3 py-2 text-left font-medium">
              Fecha de reporte
            </th>
            <th scope="col" class="border-b px-3 py-2 text-left font-medium">
              Importe reportado
            </th>
            <th scope="col" class="border-b px-3 py-2 text-left font-medium">
              Importe verificado
            </th>
            <th scope="col" class="border-b px-3 py-2 text-left font-medium">
              Estado
            </th>
          </tr>
        </thead>
        <tbody>
          {reportes.map((r) => (
            <tr>
              <td class="border-b px-3 py-2">{formatearFecha(r.submittedAt, zona)}</td>
              <td class="border-b px-3 py-2">{formatearPesos(r.reportedAmountCents)}</td>
              <td class="border-b px-3 py-2">
                {r.verifiedAmountCents === null ? "—" : formatearPesos(r.verifiedAmountCents)}
              </td>
              <td class="border-b px-3 py-2">{ESTADOS_REPORTE[r.status]}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>
  )}
  {puedePedir && (
    <section aria-labelledby="pago-titulo">
      <h2 id="pago-titulo" class="mb-2 text-2xl font-semibold">
        Pago por transferencia
      </h2>
      <PedirInstrucciones client:load token={token} />
    </section>
  )}
</PublicLayout>
