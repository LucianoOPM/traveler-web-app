{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist", "**/dist", "tests/fixtures/**/.astro"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "types": ["bun"],
    "paths": {
      "@actions/*": ["./src/actions/*"],
      "@components/*": ["./src/components/*"],
      "@db/*": ["./src/db/*"],
      "@layouts/*": ["./src/layouts/*"],
      "@lib/*": ["./src/lib/*"],
      "@modules/*": ["./src/modules/*"],
      "@pages/*": ["./src/pages/*"]
    }
  }
}
