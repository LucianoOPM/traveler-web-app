# Valores ilustrativos. Copia este archivo a .env y reemplaza CHANGE_ME y BETTER_AUTH_SECRET.
# No subas .env, contraseñas, cookies ni tokens al repositorio.
NODE_ENV=development
DATABASE_URL=postgresql://traveltech:CHANGE_ME@localhost:5432/traveltech_private
DEMO_DATABASE_URL=postgresql://traveltech:CHANGE_ME@localhost:5432/traveltech_demo
# Solo para Docker Compose; debe coincidir con la contraseña de las URLs de arriba.
POSTGRES_PASSWORD=CHANGE_ME
# Mínimo 32 caracteres aleatorios (por ejemplo: openssl rand -base64 48)
BETTER_AUTH_SECRET=GENERATE_A_LONG_RANDOM_SECRET
# URL base de la app (Better Auth la usa como baseURL).
BETTER_AUTH_URL=http://localhost:4321
PRIVATE_STORAGE_DIR=./storage/private
DEMO_STORAGE_DIR=./storage/demo
AGENCY_TIMEZONE=America/Mexico_City
# Opcional: pruebas con PostgreSQL. Descomentar con la base en marcha (docker compose up -d --wait).
# TEST_DATABASE_URL=postgresql://traveltech:CHANGE_ME@localhost:5432/traveltech_test
